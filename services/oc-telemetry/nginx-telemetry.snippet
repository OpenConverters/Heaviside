# Same-origin telemetry + Umami analytics for an OpenConverters site.
# `include` this inside each site's `server { ... }` block (the 443 vhost), so
# https://<site>.openconverters.com/telemetry and /stats are served without CORS
# and without any third-party host (adblock-resistant, first-party).
#
#   include /etc/nginx/snippets/oc-telemetry.conf;
#
# ── Interaction telemetry → the local oc-telemetry service (openconverters_telemetry schema)
location = /telemetry {
    proxy_pass http://127.0.0.1:8787/telemetry;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Beacons are tiny and fire-and-forget; keep them cheap and non-blocking.
    proxy_read_timeout 5s;
    client_max_body_size 16k;
}

# ── Umami analytics — reuse the single OM instance, which runs same-box as a
#    native Next.js process on 127.0.0.1:3000 (BASE_PATH=/stats), exactly as the
#    Heaviside vhost proxies it. Served same-origin so the tracker script is
#    first-party (adblock-resistant); data lands in the shared `umami` schema.
location = /stats { return 308 /stats/; }
location /stats/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
